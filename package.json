{
  "name": "clauderipple",
  "version": "0.4.1",
  "description": "Use GPT (ChatGPT Plus/Pro), DeepSeek and 400+ other models in the Claude Desktop Code tab and Claude Code while staying signed in to your Claude subscription — no third-party gateway mode. Several ChatGPT accounts that take over when one runs out, in Codex too.",
  "license": "GPL-3.0-only",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dist": "npm --workspace @clauderipple/app run dist",
    "release": "npm --workspace @clauderipple/app run release",
    "router": "node packages/router/src/index.ts",
    "test": "node --test packages/router/test/*.test.ts packages/cli/test/*.test.ts",
    "cli": "node packages/cli/src/index.ts",
    "prepack": "node scripts/build-npm.mjs",
    "build": "node scripts/build-npm.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/proper-lockfile": "^4.1.4",
    "typescript": "^5.9.2"
  },
  "type": "module",
  "bin": {
    "clauderipple": "bin/clauderipple.js"
  },
  "files": [
    "bin/",
    "dist/",
    "docs/ARCHITECTURE.md",
    "CHANGELOG.md",
    "README.ko.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PBJ-2/clauderipple.git"
  },
  "keywords": [
    "claude",
    "claude-desktop",
    "claude-code",
    "anthropic",
    "gpt",
    "chatgpt",
    "openai",
    "codex",
    "deepseek",
    "kimi",
    "openrouter",
    "llm",
    "proxy",
    "model-router",
    "ai-coding-assistant",
    "codex-cli",
    "chatgpt-plus",
    "claude-code-proxy",
    "llm-gateway",
    "gpt-6"
  ],
  "homepage": "https://github.com/PBJ-2/clauderipple",
  "bugs": {
    "url": "https://github.com/PBJ-2/clauderipple/issues"
  },
  "dependencies": {
    "proper-lockfile": "^4.1.2"
  }
}
