{
  "name": "@clauderipple/app",
  "version": "0.4.0",
  "private": true,
  "description": "ClaudeRipple menu-bar app (macOS). Hosts the local GUI served by the router and shows chain health in the tray.",
  "license": "GPL-3.0-only",
  "author": "pbj",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && electron .",
    "icons": "node scripts/make-icons.mts",
    "dist": "npm run icons && npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --dir -c.directories.output=release-dev",
    "release": "npm run icons && npm run build && electron-builder --mac --arm64 --x64",
    "dist:win": "npm run icons && npm run build && electron-builder --win --dir -c.directories.output=release-dev",
    "release:win": "npm run icons && npm run build && electron-builder --win"
  },
  "devDependencies": {
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.clauderipple.app",
    "productName": "ClaudeRipple",
    "electronVersion": "38.8.6",
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "icon": "build/icon.icns",
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "files": [
      "dist/**",
      "assets/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../router/src",
        "to": "clauderipple/packages/router/src"
      },
      {
        "from": "../cli/src",
        "to": "clauderipple/packages/cli/src"
      },
      {
        "from": "../ui",
        "to": "clauderipple/packages/ui"
      },
      {
        "from": "../../LICENSE",
        "to": "clauderipple/LICENSE"
      },
      {
        "from": "../../README.md",
        "to": "clauderipple/README.md"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-win-${arch}.${ext}",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ClaudeRipple",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    }
  }
}
